generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LeadTemperature {
  hot
  warm
  cold
}

enum LostReasonCategory {
  price
  no_response
  bad_timing
  service_not_compatible
  choose_another_company
  competitor
  budget
  other
}

enum FollowUpStatus {
  active
  pending
  no_response
  negotiation
  objection
  done
}

enum LeadStatus {
  open
  won
  lost
  archived
}

enum LeadTaskStatus {
  pending
  in_progress
  completed
  cancelled
  overdue
}

enum MeetingType {
  qualification_call
  discovery_call
  discovery_meeting
  proposal_presentation
  kickoff
  review
}

enum MeetingStatus {
  scheduled
  completed
  cancelled
  no_show
}

enum ProposalStatus {
  draft
  internal_review
  sent
  presented
  accepted
  rejected
  revision
}

enum ContractStatus {
  draft
  sent
  signed
  active
  completed
  terminated
}

enum ProjectStatus {
  onboarding
  strategy
  production
  active
  on_hold
  completed
  cancelled
}

enum TaskStatus {
  todo
  in_progress
  review
  approved
  delivered
  cancelled
}

enum SprintStatus {
  planning
  active
  review
  completed
}

enum DeliverableStatus {
  draft
  internal_review
  client_review
  approved
  rejected
  published
  archived
}

enum ApprovalStatus {
  pending
  approved
  rejected
  changes_requested
}

enum ApprovalType {
  internal_qc
  strategy_alignment
  client_approval
}

enum CampaignStatus {
  planning
  active
  paused
  completed
  archived
}

enum InvoiceStatus {
  draft
  sent
  paid
  overdue
  cancelled
}

enum PaymentStatus {
  pending
  completed
  failed
  refunded
}

enum SopStatus {
  draft
  published
  archived
}

enum ArticleStatus {
  draft
  published
  archived
}

enum ClientStatus {
  active
  at_risk
  churned
  archived
}

model Department {
  id                String             @id @default(uuid()) @db.Uuid
  name              String             @db.VarChar(100)
  code              String             @unique @db.VarChar(50)
  headUserId        String?            @unique @db.Uuid
  headUser          User?              @relation("DepartmentHead", fields: [headUserId], references: [id])
  description       String?            @db.Text
  createdAt         DateTime           @default(now()) @map("created_at")
  users             User[]             @relation("UserDepartment")
  teams             Team[]
  sops              Sop[]
  kpis              Kpi[]
  templates         Template[]
  knowledgeArticles KnowledgeArticle[]
  sopCompliance     SopCompliance[]
  sopTemplates      SopTemplate[]

  @@map("departments")
}

model Role {
  id              String           @id @default(uuid()) @db.Uuid
  name            String           @db.VarChar(100)
  code            String           @unique @db.VarChar(50)
  description     String?          @db.Text
  level           Int
  createdAt       DateTime         @default(now()) @map("created_at")
  users           User[]
  permissions     RolePermission[]
  sops            Sop[]            @relation("SopOwner")
  accountableSops Sop[]            @relation("SopAccountable")

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  resource    String           @db.VarChar(100)
  action      String           @db.VarChar(50)
  description String?          @db.Text
  roles       RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id           String      @id @default(uuid()) @db.Uuid
  email        String      @unique @db.VarChar(255)
  passwordHash String      @map("password_hash") @db.VarChar(255)
  firstName    String      @map("first_name") @db.VarChar(100)
  lastName     String      @map("last_name") @db.VarChar(100)
  phone        String?     @db.VarChar(50)
  avatarUrl    String?     @map("avatar_url") @db.Text
  roleId       String?     @map("role_id") @db.Uuid
  role         Role?       @relation(fields: [roleId], references: [id])
  departmentId String?     @map("department_id") @db.Uuid
  department   Department? @relation("UserDepartment", fields: [departmentId], references: [id])
  headOfDept   Department? @relation("DepartmentHead")
  isActive       Boolean    @default(true) @map("is_active")
  moduleAccess   Json?      @map("module_access")
  lastLogin      DateTime?  @map("last_login") @db.Timestamptz()
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  assignedLeads         Lead[]               @relation("LeadAssignee")
  accountManagedClients Client[]             @relation("AccountManager")
  activities            Activity[]
  meetings              Meeting[]            @relation("MeetingOwner")
  proposals             Proposal[]           @relation("ProposalOwner")
  projectAccountManager Project[]            @relation("ProjectAccountManager")
  projectStrategicLead  Project[]            @relation("ProjectStrategicLead")
  projectProductionMgr  Project[]            @relation("ProjectProductionManager")
  assignedTasks         Task[]               @relation("TaskAssignee")
  deliverables          Deliverable[]        @relation("DeliverableOwner")
  approvals             Approval[]
  notifications         Notification[]
  knowledgeArticles     KnowledgeArticle[]
  opportunities         Opportunity[]        @relation("OpportunityOwner")
  teamMembers           TeamMember[]
  teamsLead             Team[]               @relation("TeamLead")
  dashboards            Dashboard[]
  leadScores            LeadScore[]
  timeEntries           TimeEntry[]
  auditLogs             AuditLog[]
  researchReports       ResearchReport[]
  strategicBlueprints   StrategicBlueprint[]
  creativeBriefs        CreativeBrief[]
  blueprintApprovals    StrategicBlueprint[] @relation("BlueprintApprover")
  briefApprovals        CreativeBrief[]      @relation("BriefApprover")
  sopVersions           SopVersion[]
  sopExecutions         SopExecution[]
  sopExecutionSteps     SopExecutionStep[]
  sopComplianceChecked  SopCompliance[]      @relation("ComplianceChecker")
  sopApprovalRequests   SopApproval[]        @relation("ApprovalRequester")
  sopApprovalDecisions  SopApproval[]        @relation("ApprovalDecider")
  sopTrainingCreated    SopTraining[]
  sopTemplates          SopTemplate[]
  processRecordings     ProcessRecording[]
  processChecklists     ProcessChecklist[]
  processImprovements   ProcessImprovement[]
  SopCompliance         SopCompliance[]
  leadQualifications    LeadQualification[]  @relation("LeadQualifier")
  leadAttachments       LeadAttachment[]     @relation("AttachmentUploader")
  leadTaskAssignments   LeadTask[]           @relation("LeadTaskAssignee")
  communicationLogs     CommunicationLog[]
  calendarEvents        CalendarEvent[]
  dashboardWidgets      DashboardWidget[]

  @@map("users")
}

model Team {
  id           String       @id @default(uuid()) @db.Uuid
  name         String       @db.VarChar(100)
  departmentId String?      @map("department_id") @db.Uuid
  department   Department?  @relation(fields: [departmentId], references: [id])
  leadUserId   String?      @map("lead_user_id") @db.Uuid
  leadUser     User?        @relation("TeamLead", fields: [leadUserId], references: [id])
  createdAt    DateTime     @default(now()) @map("created_at")
  members      TeamMember[]
  projects     Project[]

  @@map("teams")
}

model TeamMember {
  userId     String   @map("user_id") @db.Uuid
  teamId     String   @map("team_id") @db.Uuid
  roleInTeam String?  @map("role_in_team") @db.VarChar(50)
  joinedAt   DateTime @default(now()) @map("joined_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  team       Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@id([userId, teamId])
  @@map("team_members")
}

model PipelineStage {
  id                 String   @id @default(uuid()) @db.Uuid
  name               String   @db.VarChar(100)
  code               String   @unique @db.VarChar(50)
  stageOrder         Int      @map("stage_order")
  probabilityDefault Int      @default(0) @map("probability_default")
  color              String?  @db.VarChar(7)
  createdAt          DateTime @default(now()) @map("created_at")
  leads              Lead[]

  @@map("pipeline_stages")
}

model Lead {
  id                 String             @id @default(uuid()) @db.Uuid
  clientName         String             @map("client_name") @db.VarChar(255)
  company            String?            @db.VarChar(255)
  email              String?            @db.VarChar(255)
  phone              String?            @db.VarChar(50)
  website            String?            @db.Text
  budgetMin          Decimal?           @map("budget_min") @db.Decimal(12, 2)
  budgetMax          Decimal?           @map("budget_max") @db.Decimal(12, 2)
  source             String             @db.VarChar(50)
  city               String?            @db.VarChar(100)
  industry           String?            @db.VarChar(100)
  tags               String[]           @db.Text
  priority           String?            @default("medium") @db.VarChar(10)
  serviceType        String?            @map("service_type") @db.VarChar(50)
  clarityLevel       String?            @map("clarity_level") @db.VarChar(20)
  budgetLevel        String?            @map("budget_level") @db.VarChar(20)
  opportunitySize    String?            @map("opportunity_size") @db.VarChar(20)
  leadScore          Int?               @map("lead_score")
  leadTemperature    LeadTemperature?   @map("lead_temperature")
  stageId            String?            @map("stage_id") @db.Uuid
  stage              PipelineStage?     @relation(fields: [stageId], references: [id])
  assignedTo         String?            @map("assigned_to") @db.Uuid
  assignee           User?              @relation("LeadAssignee", fields: [assignedTo], references: [id])
  nextAction         String?            @map("next_action") @db.Text
  nextActionDate     DateTime?          @map("next_action_date") @db.Timestamptz()
  followUpDate       DateTime?          @map("follow_up_date") @db.Timestamptz()
  followUpStatus     FollowUpStatus?    @map("follow_up_status")
  proposalSent       Boolean            @default(false) @map("proposal_sent")
  dealValue          Decimal?           @map("deal_value") @db.Decimal(12, 2)
  probability        Int?
  status             LeadStatus         @default(open)
  lostReason         String?            @map("lost_reason") @db.Text
  lostReasonCategory LostReasonCategory? @map("lost_reason_category")
  lastContactedAt    DateTime?          @map("last_contacted_at") @db.Timestamptz()
  sopId              String?            @map("sop_id") @db.Uuid
  sop                Sop?               @relation(fields: [sopId], references: [id])
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  client            Client?            @relation("LeadToClient")
  activities        Activity[]
  meetings          Meeting[]
  leadScores        LeadScore[]
  sopExecutions     SopExecution[]
  communicationLogs CommunicationLog[]
  calendarEvents    CalendarEvent[]
  qualification     LeadQualification?
  attachments       LeadAttachment[]
  leadTasks         LeadTask[]
  followUps         LeadFollowUp[]

  @@index([assignedTo])
  @@index([stageId])
  @@index([leadScore])
  @@index([status])
  @@index([source])
  @@index([createdAt])
  @@map("leads")
}

model LeadFollowUp {
  id         String          @id @default(uuid()) @db.Uuid
  leadId     String          @map("lead_id") @db.Uuid
  lead       Lead            @relation(fields: [leadId], references: [id], onDelete: Cascade)
  title      String          @db.VarChar(255)
  dueDate    DateTime        @map("due_date") @db.Timestamptz()
  status     FollowUpStatus  @default(active)
  chainOrder Int?            @map("chain_order")
  chainId    String?         @map("chain_id") @db.VarChar(100)
  createdAt  DateTime        @default(now()) @map("created_at")
  updatedAt  DateTime        @updatedAt @map("updated_at")

  @@index([leadId])
  @@index([dueDate])
  @@index([chainId])
  @@map("lead_follow_ups")
}

model LeadQualification {
  id               String   @id @default(uuid()) @db.Uuid
  leadId           String   @unique @map("lead_id") @db.Uuid
  lead             Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  serviceRequested String?  @map("service_requested") @db.Text
  businessGoal     String?  @map("business_goal") @db.Text
  budget           String?  @db.VarChar(50)
  urgency          String?  @db.VarChar(50)
  previousAgency   String?  @map("previous_agency") @db.Text
  expectedTimeline String?  @map("expected_timeline") @db.Text
  decisionMaker    String?  @map("decision_maker") @db.Text
  additionalNotes  String?  @map("additional_notes") @db.Text
  qualifiedById    String?  @map("qualified_by_id") @db.Uuid
  qualifiedBy      User?    @relation("LeadQualifier", fields: [qualifiedById], references: [id])
  qualifiedAt      DateTime @default(now()) @map("qualified_at")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("lead_qualifications")
}

model LeadAttachment {
  id           String   @id @default(uuid()) @db.Uuid
  leadId       String   @map("lead_id") @db.Uuid
  lead         Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  fileName     String   @map("file_name") @db.VarChar(255)
  fileUrl      String   @map("file_url") @db.Text
  fileType     String?  @map("file_type") @db.VarChar(50)
  fileSize     Int?     @map("file_size")
  uploadedById String?  @map("uploaded_by_id") @db.Uuid
  uploadedBy   User?    @relation("AttachmentUploader", fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([leadId])
  @@map("lead_attachments")
}

model LeadTask {
  id          String         @id @default(uuid()) @db.Uuid
  leadId      String         @map("lead_id") @db.Uuid
  lead        Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  title       String         @db.VarChar(255)
  description String?        @db.Text
  taskType    String?        @map("task_type") @db.VarChar(50)
  status      LeadTaskStatus @default(pending)
  priority    String         @default("medium") @db.VarChar(10)
  assignedTo  String?        @map("assigned_to") @db.Uuid
  assignee    User?          @relation("LeadTaskAssignee", fields: [assignedTo], references: [id])
  dueDate     DateTime?      @map("due_date") @db.Timestamptz()
  completedAt DateTime?      @map("completed_at") @db.Timestamptz()
  reminderAt  DateTime?      @map("reminder_at") @db.Timestamptz()
  chainOrder  Int?           @map("chain_order")
  chainTotal  Int?           @map("chain_total")
  chainId     String?        @map("chain_id") @db.VarChar(100)
  chainBlueprint Json?       @map("chain_blueprint") @db.JsonB
  checklist    Json?          @db.JsonB
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  @@index([leadId])
  @@index([assignedTo])
  @@index([status])
  @@index([dueDate])
  @@index([chainId])
  @@map("lead_tasks")
}

model LeadScore {
  id               String   @id @default(uuid()) @db.Uuid
  leadId           String   @map("lead_id") @db.Uuid
  lead             Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  serviceTypeScore Int      @map("service_type_score")
  clarityScore     Int      @map("clarity_score")
  budgetScore      Int      @map("budget_score")
  opportunityScore Int      @map("opportunity_score")
  totalScore       Int      @map("total_score")
  scoredBy         String?  @map("scored_by") @db.Uuid
  scorer           User?    @relation(fields: [scoredBy], references: [id])
  createdAt        DateTime @default(now()) @map("created_at")

  @@map("lead_scores")
}

model Activity {
  id          String   @id @default(uuid()) @db.Uuid
  leadId      String   @map("lead_id") @db.Uuid
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId      String?  @map("user_id") @db.Uuid
  user        User?    @relation(fields: [userId], references: [id])
  actionType  String   @map("action_type") @db.VarChar(50)
  description String?  @db.Text
  outcome     String?  @db.Text
  nextStep    String?  @map("next_step") @db.Text
  metadata    Json?    @db.JsonB
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([leadId])
  @@index([userId])
  @@index([createdAt])
  @@map("activities")
}

model Client {
  id                String       @id @default(uuid()) @db.Uuid
  leadId            String?      @unique @map("lead_id") @db.Uuid
  lead              Lead?        @relation("LeadToClient", fields: [leadId], references: [id])
  name              String       @db.VarChar(255)
  company           String?      @db.VarChar(255)
  email             String?      @db.VarChar(255)
  phone             String?      @db.VarChar(50)
  website           String?      @db.Text
  industry          String?      @db.VarChar(100)
  accountManagerId  String?      @map("account_manager_id") @db.Uuid
  accountManager    User?        @relation("AccountManager", fields: [accountManagerId], references: [id])
  status            ClientStatus @default(active)
  satisfactionScore Int?
  lifetimeValue     Decimal?     @map("lifetime_value") @db.Decimal(14, 2)
  acquiredAt        DateTime?    @map("acquired_at") @db.Timestamptz()
  churnedAt         DateTime?    @map("churned_at") @db.Timestamptz()
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  opportunities     Opportunity[]
  proposals         Proposal[]
  contracts         Contract[]
  projects          Project[]
  invoices          Invoice[]
  communicationLogs CommunicationLog[]
  calendarEvents    CalendarEvent[]
  portalAccess      ClientPortalAccess[]

  @@map("clients")
}

model Opportunity {
  id                String     @id @default(uuid()) @db.Uuid
  clientId          String     @map("client_id") @db.Uuid
  client            Client     @relation(fields: [clientId], references: [id])
  name              String     @db.VarChar(255)
  description       String?    @db.Text
  value             Decimal?   @db.Decimal(12, 2)
  stage             String     @default("discovery") @db.VarChar(50)
  probability       Int?
  expectedCloseDate DateTime?  @map("expected_close_date") @db.Timestamptz()
  ownerId           String?    @map("owner_id") @db.Uuid
  owner             User?      @relation("OpportunityOwner", fields: [ownerId], references: [id])
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")
  proposals         Proposal[]

  @@map("opportunities")
}

model Meeting {
  id              String        @id @default(uuid()) @db.Uuid
  leadId          String?       @map("lead_id") @db.Uuid
  lead            Lead?         @relation(fields: [leadId], references: [id])
  type            MeetingType?
  scheduledAt     DateTime      @map("scheduled_at") @db.Timestamptz()
  durationMinutes Int?          @map("duration_minutes")
  status          MeetingStatus @default(scheduled)
  notes           String?       @db.Text
  recordingUrl    String?       @map("recording_url") @db.Text
  outcome         String?       @db.Text
  nextStep        String?       @map("next_step") @db.Text
  ownerId         String?       @map("owner_id") @db.Uuid
  owner           User?         @relation("MeetingOwner", fields: [ownerId], references: [id])
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  @@map("meetings")
}

model Proposal {
  id               String         @id @default(uuid()) @db.Uuid
  opportunityId    String?        @map("opportunity_id") @db.Uuid
  opportunity      Opportunity?   @relation(fields: [opportunityId], references: [id])
  clientId         String?        @map("client_id") @db.Uuid
  client           Client?        @relation(fields: [clientId], references: [id])
  title            String         @db.VarChar(255)
  version          String         @default("v1.0") @db.VarChar(10)
  status           ProposalStatus @default(draft)
  technicalContent String?        @map("technical_content") @db.Text
  financialContent String?        @map("financial_content") @db.Text
  scopeOfWork      Json?          @map("scope_of_work") @db.JsonB
  expectations     String?        @db.Text
  totalValue       Decimal?       @map("total_value") @db.Decimal(12, 2)
  currency         String         @default("LYD") @db.VarChar(3)
  validityDays     Int            @default(7) @map("validity_days")
  sentAt           DateTime?      @map("sent_at") @db.Timestamptz()
  acceptedAt       DateTime?      @map("accepted_at") @db.Timestamptz()
  rejectedAt       DateTime?      @map("rejected_at") @db.Timestamptz()
  rejectionReason  String?        @map("rejection_reason") @db.Text
  ownerId          String?        @map("owner_id") @db.Uuid
  owner            User?          @relation("ProposalOwner", fields: [ownerId], references: [id])
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  contract         Contract?

  @@map("proposals")
}

model Contract {
  id               String         @id @default(uuid()) @db.Uuid
  proposalId       String?        @unique @map("proposal_id") @db.Uuid
  proposal         Proposal?      @relation(fields: [proposalId], references: [id])
  clientId         String?        @map("client_id") @db.Uuid
  client           Client?        @relation(fields: [clientId], references: [id])
  contractNumber   String         @unique @map("contract_number") @db.VarChar(50)
  status           ContractStatus @default(draft)
  scopeOfWork      Json?          @map("scope_of_work") @db.JsonB
  startDate        DateTime?      @map("start_date") @db.Date
  endDate          DateTime?      @map("end_date") @db.Date
  totalValue       Decimal?       @map("total_value") @db.Decimal(12, 2)
  paymentTerms     String?        @map("payment_terms") @db.Text
  specialTerms     String?        @map("special_terms") @db.Text
  signedAt         DateTime?      @map("signed_at") @db.Timestamptz()
  signedByClientAt DateTime?      @map("signed_by_client_at") @db.Timestamptz()
  fileUrl          String?        @map("file_url") @db.Text
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  projects         Project[]
  invoices         Invoice[]

  @@map("contracts")
}

model Project {
  id                  String        @id @default(uuid()) @db.Uuid
  clientId            String        @map("client_id") @db.Uuid
  client              Client        @relation(fields: [clientId], references: [id])
  contractId          String?       @map("contract_id") @db.Uuid
  contract            Contract?     @relation(fields: [contractId], references: [id])
  name                String        @db.VarChar(255)
  description         String?       @db.Text
  status              ProjectStatus @default(onboarding)
  priority            String        @default("medium") @db.VarChar(10)
  startDate           DateTime?     @map("start_date") @db.Date
  targetEndDate       DateTime?     @map("target_end_date") @db.Date
  actualEndDate       DateTime?     @map("actual_end_date") @db.Date
  accountManagerId    String?       @map("account_manager_id") @db.Uuid
  accountManager      User?         @relation("ProjectAccountManager", fields: [accountManagerId], references: [id])
  strategicLeadId     String?       @map("strategic_lead_id") @db.Uuid
  strategicLead       User?         @relation("ProjectStrategicLead", fields: [strategicLeadId], references: [id])
  productionManagerId String?       @map("production_manager_id") @db.Uuid
  productionManager   User?         @relation("ProjectProductionManager", fields: [productionManagerId], references: [id])
  budget              Decimal?      @db.Decimal(12, 2)
  hourlyRate          Decimal?      @map("hourly_rate") @db.Decimal(8, 2)
  estimatedHours      Int?          @map("estimated_hours")
  sopId               String?       @map("sop_id") @db.Uuid
  sop                 Sop?          @relation(fields: [sopId], references: [id])
  teamId              String?       @map("team_id") @db.Uuid
  team                Team?         @relation(fields: [teamId], references: [id])
