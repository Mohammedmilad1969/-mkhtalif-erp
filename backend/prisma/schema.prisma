  sopId       String?                @map("sop_id") @db.Uuid
  sop         Sop?                   @relation(fields: [sopId], references: [id])
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @updatedAt @map("updated_at")
  screenshots ProcessScreenshot[]

  @@map("process_recordings")
}

model ProcessScreenshot {
  id          String           @id @default(uuid()) @db.Uuid
  recordingId String           @map("recording_id") @db.Uuid
  recording   ProcessRecording @relation(fields: [recordingId], references: [id], onDelete: Cascade)
