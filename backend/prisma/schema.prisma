enum CommunicationChannel {
  email
  sms
  whatsapp
  call
  internal_note
}

enum CommunicationDirection {
  inbound
  outbound
}

model CommunicationLog {
  id           String                 @id @default(uuid()) @db.Uuid
  leadId       String?                @map("lead_id") @db.Uuid
  lead         Lead?                  @relation(fields: [leadId], references: [id])
  clientId     String?                @map("client_id") @db.Uuid
  client       Client?                @relation(fields: [clientId], references: [id])
  channel      CommunicationChannel
  direction    CommunicationDirection @default(outbound)
  subject      String?                @db.VarChar(255)
  body         String?                @db.Text
  fromAddress  String?                @map("from_address") @db.VarChar(255)
  toAddress    String?                @map("to_address") @db.VarChar(255)
  ccAddresses  String[]               @map("cc_addresses") @db.Text
  bccAddresses String[]               @map("bcc_addresses") @db.Text
  attachments  Json?                  @db.JsonB
  status       String                 @default("sent") @db.VarChar(20)
  externalId   String?                @map("external_id") @db.VarChar(255)
  metadata     Json?                  @db.JsonB
  createdById  String?                @map("created_by_id") @db.Uuid
  createdBy    User?                  @relation(fields: [createdById], references: [id])
  createdAt    DateTime               @default(now()) @map("created_at")

  @@index([leadId])
  @@index([clientId])
  @@index([createdAt])
  @@map("communication_logs")
}

model CalendarEvent {
  id          String    @id @default(uuid()) @db.Uuid
  title       String    @db.VarChar(255)
  description String?   @db.Text
  eventType   String?   @map("event_type") @db.VarChar(50)
  startTime   DateTime  @map("start_time") @db.Timestamptz()
  endTime     DateTime? @map("end_time") @db.Timestamptz()
  allDay      Boolean   @default(false) @map("all_day")
  location    String?   @db.VarChar(255)
  meetingUrl  String?   @map("meeting_url") @db.Text
  leadId      String?   @map("lead_id") @db.Uuid
  lead        Lead?     @relation(fields: [leadId], references: [id])
  clientId    String?   @map("client_id") @db.Uuid
  client      Client?   @relation(fields: [clientId], references: [id])
  projectId   String?   @map("project_id") @db.Uuid
  project     Project?  @relation(fields: [projectId], references: [id])
  ownerId     String?   @map("owner_id") @db.Uuid
  owner       User?     @relation(fields: [ownerId], references: [id])
  color       String?   @db.VarChar(7)
  isCompleted Boolean   @default(false) @map("is_completed")
  recurrence  Json?     @db.JsonB
  reminders   Json?     @db.JsonB
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([startTime])
  @@index([ownerId])
  @@index([leadId])
  @@index([clientId])
  @@map("calendar_events")
}

model DashboardWidget {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  widgetType   String   @map("widget_type") @db.VarChar(50)
  title        String   @db.VarChar(255)
  config       Json?    @db.JsonB
  gridPosition Json?    @map("grid_position") @db.JsonB
  isVisible    Boolean  @default(true) @map("is_visible")
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([userId, widgetType])
  @@map("dashboard_widgets")
}

model ClientPortalAccess {
  id           String    @id @default(uuid()) @db.Uuid
  clientId     String    @map("client_id") @db.Uuid
  client       Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  token        String    @unique @db.VarChar(255)
  email        String    @db.VarChar(255)
  lastAccessAt DateTime? @map("last_access_at") @db.Timestamptz()
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([clientId])
  @@index([token])
  @@map("client_portal_access")
}

