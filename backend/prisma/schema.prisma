  processChecklists ProcessChecklist[]

  @@index([sopId])
  @@index([status])
  @@map("sop_executions")
}

model SopExecutionStep {
  id           String             @id @default(uuid()) @db.Uuid
  executionId  String             @map("execution_id") @db.Uuid
  execution    SopExecution       @relation(fields: [executionId], references: [id], onDelete: Cascade)
  stepKey      String             @map("step_key") @db.VarChar(100)
  stepName     String             @map("step_name") @db.VarChar(255)
  description  String?            @db.Text
  status       SopExecutionStatus @default(pending)
  assignedToId String?            @map("assigned_to_id") @db.Uuid
  assignedTo   User?              @relation(fields: [assignedToId], references: [id])
  startedAt    DateTime?          @map("started_at") @db.Timestamptz()
  completedAt  DateTime?          @map("completed_at") @db.Timestamptz()
  duration     Int?               @map("duration")
  notes        String?            @db.Text
  output       Json?              @db.JsonB
  sortOrder    Int                @default(0) @map("sort_order")
  createdAt    DateTime           @default(now()) @map("created_at")
  Task         Task[]

  @@index([executionId])
  @@map("sop_execution_steps")
}

model SopCompliance {
  id           String        @id @default(uuid()) @db.Uuid
  sopId        String        @map("sop_id") @db.Uuid
  sop          Sop           @relation(fields: [sopId], references: [id])
  executionId  String?       @map("execution_id") @db.Uuid
  execution    SopExecution? @relation(fields: [executionId], references: [id])
  departmentId String?       @map("department_id") @db.Uuid
  department   Department?   @relation(fields: [departmentId], references: [id])
  userId       String?       @map("user_id") @db.Uuid
  user         User?         @relation(fields: [userId], references: [id])
  status       String        @default("compliant") @db.VarChar(20)
  score        Decimal?      @db.Decimal(5, 2)
  checkedAt    DateTime      @default(now()) @map("checked_at") @db.Timestamptz()
  checkedById  String?       @map("checked_by_id") @db.Uuid
  checkedBy    User?         @relation("ComplianceChecker", fields: [checkedById], references: [id])
  notes        String?       @db.Text
  createdAt    DateTime      @default(now()) @map("created_at")

  @@index([sopId])
  @@index([departmentId])
  @@index([userId])
  @@map("sop_compliance")
}

model SopApproval {
  id            String              @id @default(uuid()) @db.Uuid
  sopId         String              @map("sop_id") @db.Uuid
  sop           Sop                 @relation(fields: [sopId], references: [id])
  versionId     String?             @map("version_id") @db.Uuid
  version       SopVersion?         @relation(fields: [versionId], references: [id])
  stepKey       String?             @map("step_key") @db.VarChar(100)
  requestedById String?             @map("requested_by_id") @db.Uuid
  requestedBy   User?               @relation("ApprovalRequester", fields: [requestedById], references: [id])
  approvedById  String?             @map("approved_by_id") @db.Uuid
  approvedBy    User?               @relation("ApprovalDecider", fields: [approvedById], references: [id])
  status        SopApprovalDecision @default(pending)
  comments      String?             @db.Text
  requestedAt   DateTime            @default(now()) @map("requested_at") @db.Timestamptz()
  decidedAt     DateTime?           @map("decided_at") @db.Timestamptz()
  createdAt     DateTime            @default(now()) @map("created_at")

  @@index([sopId, status])
  @@map("sop_approvals")
}

model SopTraining {
  id          String   @id @default(uuid()) @db.Uuid
  sopId       String   @map("sop_id") @db.Uuid
  sop         Sop      @relation(fields: [sopId], references: [id], onDelete: Cascade)
  name        String   @db.VarChar(255)
  type        String   @db.VarChar(50)
  content     String?  @db.Text
  videoUrl    String?  @map("video_url") @db.Text
  duration    Int?     @map("duration")
  quizData    Json?    @map("quiz_data") @db.JsonB
  createdById String?  @map("created_by_id") @db.Uuid
  createdBy   User?    @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([sopId])
  @@map("sop_training")
}

model SopTemplate {
  id           String      @id @default(uuid()) @db.Uuid
  name         String      @db.VarChar(255)
  description  String?     @db.Text
  category     String?     @db.VarChar(100)
  departmentId String?     @map("department_id") @db.Uuid
  department   Department? @relation(fields: [departmentId], references: [id])
  steps        Json?       @db.JsonB
  content      Json?       @db.JsonB
  version      String      @default("v1.0") @db.VarChar(10)
  usageCount   Int         @default(0) @map("usage_count")
  createdById  String?     @map("created_by_id") @db.Uuid
