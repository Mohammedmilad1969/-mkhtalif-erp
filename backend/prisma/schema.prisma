model ProcessRecording {
  id          String                 @id @default(uuid()) @db.Uuid
  name        String                 @db.VarChar(255)
  description String?                @db.Text
  status      ProcessRecordingStatus @default(recording)
  steps       Json?                  @db.JsonB
  duration    Int?                   @map("duration")
